@page "/Account/ClaimOrder"
@model TranslationOffice.Pages.Account.ClaimOrderModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>اتصال سفارش به حساب کاربری</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">

                <div class="card shadow-sm">
                    <div class="card-body p-4 text-center">

                        <h4 class="mb-3">اتصال سفارش به حساب کاربری</h4>

                        <p class="text-muted">
                            سفارش شما با موفقیت شناسایی شد.
                            آیا می‌خواهید آن را به حساب کاربری خود متصل کنید؟
                        </p>

                        <p>
                            شماره سفارش:
                            <strong>@Model.OrderNumber</strong>
                        </p>

                        <form method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="OrderId" />
                            <input type="hidden" asp-for="Token" />

                            <button type="submit" class="btn btn-success w-100 mb-2">
                                اتصال سفارش به حساب من
                            </button>

                            <a href="/" class="btn btn-outline-secondary w-100">
                                بازگشت به صفحه اصلی
                            </a>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>

</body>
</html>
