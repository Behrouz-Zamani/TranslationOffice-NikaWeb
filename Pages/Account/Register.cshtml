@page "/Account/Register"
@model TranslationOffice.Pages.Account.RegisterModel

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ثبت‌نام | دارالترجمه رسمی</title>

    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/app.css" asp-append-version="true" />

</head>

<body>

    <div class="register-wrapper">

        <section class="register-form-panel">

            <a href="/" class="register-logo">
                <span class="register-logo-icon">📄</span>
                <span>دارالترجمه رسمی</span>
            </a>

            <h1 class="register-title">ایجاد حساب کاربری</h1>

            <p class="register-description">
                برای ثبت و پیگیری سفارش‌های ترجمه، اطلاعات خود را وارد کنید.
            </p>

            <form method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label">
                            نام
                        </label>

                        <input asp-for="FirstName"
                               class="form-control"
                               placeholder="نام خود را وارد کنید"
                               autocomplete="given-name" />

                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label">
                            نام خانوادگی
                        </label>

                        <input asp-for="LastName"
                               class="form-control"
                               placeholder="نام خانوادگی"
                               autocomplete="family-name" />

                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Phone" class="form-label">
                            شماره موبایل
                        </label>

                        <input asp-for="Phone"
                               class="form-control phone-input"
                               placeholder="09123456789"
                               dir="ltr"
                               autocomplete="tel" />

                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Password" class="form-label">
                            رمز عبور
                        </label>

                        <div class="password-wrapper">
                            <input asp-for="Password"
                                   type="password"
                                   id="registerPassword"
                                   class="form-control"
                                   placeholder="حداقل ۶ کاراکتر"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('registerPassword', this)">
                                نمایش
                            </button>
                        </div>

                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ConfirmPassword" class="form-label">
                            تکرار رمز عبور
                        </label>

                        <div class="password-wrapper">
                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   id="confirmPassword"
                                   class="form-control"
                                   placeholder="رمز عبور را مجدداً وارد کنید"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('confirmPassword', this)">
                                نمایش
                            </button>
                        </div>

                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                </div>

                <button type="submit" class="btn register-submit">
                    ایجاد حساب کاربری
                </button>

            </form>

            <div class="register-bottom">
                قبلاً ثبت‌نام کرده‌اید؟
                <a asp-page="/Account/Login"
                   asp-route-returnUrl="@Model.ReturnUrl">
                    وارد شوید
                </a>
            </div>

            <div class="register-bottom mt-3">
                <a href="/">بازگشت به صفحه اصلی</a>
            </div>

        </section>

        <aside class="register-side">

            <div class="side-content">

                <span class="side-badge">به خانواده ما بپیوندید</span>

                <h2>
                    شروع یک تجربه
                    <span>ساده و مطمئن</span>
                </h2>

                <p>
                    با ساخت حساب کاربری، سفارش‌های خود را ثبت و مدیریت کنید
                    و در تمام مراحل ترجمه به اطلاعات سفارش دسترسی داشته باشید.
                </p>

                <div class="side-benefits">
                    <div class="side-benefit">
                        <span>✓</span>
                        ثبت سفارش آنلاین
                    </div>

                    <div class="side-benefit">
                        <span>✓</span>
                        مشاهده هزینه پیش از ثبت
                    </div>

                    <div class="side-benefit">
                        <span>✓</span>
                        پیگیری و دریافت مدارک
                    </div>
                </div>

            </div>

        </aside>

    </div>

    <script>
            function togglePassword(inputId, button) {
                const input = document.getElementById(inputId);

                if (!input) return;

                if (input.type === "password") {
                    input.type = "text";
                    button.textContent = "مخفی";
                } else {
                    input.type = "password";
                    button.textContent = "نمایش";
                }
            }
    </script>

</body>
</html>
