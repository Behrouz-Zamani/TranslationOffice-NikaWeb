@* @layout AdminLayout *@
@page "/admin/orders"

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using TranslationOffice.Data
@using TranslationOffice.Models

@attribute [Authorize]
@rendermode InteractiveServer

@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>مدیریت سفارش‌ها</PageTitle>

@if (!isAuthorized)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-3">در حال بررسی دسترسی...</p>
    </div>
}
else if (orders == null && isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-3">در حال بارگذاری اطلاعات...</p>
    </div>
}
else
{
    <div class="container-fluid py-3" dir="rtl">

        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <div>
                <h3 class="fw-bold mb-1">مدیریت سفارش‌ها</h3>
                <div class="text-muted small">
                    مشاهده و پیگیری سفارش‌های ثبت‌شده
                </div>
            </div>

            <button class="btn btn-outline-primary"
                    @onclick="LoadData"
                    disabled="@isLoading">
                <i class="bi bi-arrow-clockwise ms-1"></i>
                بروزرسانی
            </button>
        </div>

        @if (orders != null)
        {
            <div class="row g-3 mb-4">

                <div class="col-6 col-lg-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-muted small mb-2">کل سفارش‌ها</div>
                            <h3 class="fw-bold mb-0">@orders.Count</h3>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-muted small mb-2">در انتظار پرداخت</div>
                            <h3 class="fw-bold text-warning mb-0">
                                @orders.Count(x => x.Status == "PendingPayment")
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-muted small mb-2">در حال ترجمه</div>
                            <h3 class="fw-bold text-primary mb-0">
                                @orders.Count(x => x.ProgressStatus == "InProgress")
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-muted small mb-2">تکمیل‌شده</div>
                            <h3 class="fw-bold text-success mb-0">
                                @orders.Count(x => x.ProgressStatus == "Completed")
                            </h3>
                        </div>
                    </div>
                </div>

            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold">فهرست سفارش‌ها</h5>
                </div>

                <div class="card-body p-0">

                    @if (!orders.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox fs-1 text-muted"></i>
                            <p class="text-muted mt-3 mb-0">
                                هنوز سفارشی ثبت نشده است.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">
                                    <tr>
                                        <th class="px-3">شماره سفارش</th>
                                        <th>تاریخ</th>
                                        <th>مبلغ کل</th>
                                        <th>وضعیت پرداخت</th>
                                        <th>وضعیت ترجمه</th>
                                        <th>تعداد آیتم</th>
                                        <th class="text-center">عملیات</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var order in orders)
                                    {
                                        <tr>
                                            <td class="px-3">
                                                <strong>@order.OrderNumber</strong>
                                            </td>

                                            <td>
                                                @order.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                                            </td>

                                            <td class="fw-semibold">
                                                @order.TotalPrice.ToString("N0") تومان
                                            </td>

                                            <td>
                                                <span class="badge @GetPaymentBadgeClass(order.Status)">
                                                    @GetPaymentStatusTitle(order.Status)
                                                </span>
                                            </td>

                                            <td>
                                                <span class="badge @GetProgressBadgeClass(order.ProgressStatus)">
                                                    @GetProgressStatusTitle(order.ProgressStatus)
                                                </span>
                                            </td>

                                            <td>
                                                @order.Items.Count
                                            </td>

                                            <td class="text-center">
                                                <a class="btn btn-sm btn-outline-primary"
                                                   href="@($"/admin/orders/{order.Id}")">
                                                    <i class="bi bi-eye ms-1"></i>
                                                    جزئیات
                                                </a>

                                                <button class="btn btn-sm btn-outline-secondary me-1"
                                                        @onclick="() => ToggleDetails(order.Id)">
                                                    @(expandedOrderId == order.Id ? "بستن" : "نمایش آیتم‌ها")
                                                </button>
                                            </td>
                                        </tr>

                                        @if (expandedOrderId == order.Id)
                                        {
                                            <tr>
                                                <td colspan="7" class="bg-light p-3">

                                                    <div class="row g-2 mb-3">
                                                        <div class="col-md-4">
                                                            <strong>شماره سفارش:</strong>
                                                            @order.OrderNumber
                                                        </div>

                                                        <div class="col-md-4">
                                                            <strong>وضعیت پرداخت:</strong>
                                                            @GetPaymentStatusTitle(order.Status)
                                                        </div>

                                                        <div class="col-md-4">
                                                            <strong>وضعیت ترجمه:</strong>
                                                            @GetProgressStatusTitle(order.ProgressStatus)
                                                        </div>
                                                    </div>

                                                    <div class="table-responsive">
                                                        <table class="table table-sm table-bordered bg-white mb-0">

                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>مدرک</th>
                                                                    <th>تعداد نسخه</th>
                                                                    <th>سطر/صفحه</th>
                                                                    <th>دادگستری</th>
                                                                    <th>خارجه</th>
                                                                    <th>قیمت</th>
                                                                    <th>وضعیت ترجمه</th>
                                                                    <th>مترجم</th>
                                                                </tr>
                                                            </thead>

                                                            <tbody>
                                                                @foreach (var item in order.Items)
                                                                {
                                                                    <tr>
                                                                        <td>
                                                                            @item.DocumentType?.Name
                                                                        </td>

                                                                        <td>
                                                                            @item.Quantity
                                                                        </td>

                                                                        <td>
                                                                            @item.Units
                                                                        </td>

                                                                        <td>
                                                                            @(item.NeedJudiciary ? "بله" : "خیر")
                                                                        </td>

                                                                        <td>
                                                                            @(item.NeedForeignAffairs ? "بله" : "خیر")
                                                                        </td>

                                                                        <td>
                                                                            @item.TotalPrice.ToString("N0") تومان
                                                                        </td>

                                                                        <td>
                                                                            <span class="badge @GetItemStatusBadgeClass(item.Status)">
                                                                                @GetItemStatusTitle(item.Status)
                                                                            </span>
                                                                        </td>

                                                                        <td>
                                                                            @(string.IsNullOrWhiteSpace(item.TranslatorId)
                                                                                ? "تعیین نشده"
                                                                                : "اختصاص داده شده")
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>

                                                        </table>
                                                    </div>

                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>

                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger mt-3" dir="rtl">
        @errorMessage
    </div>
}

@code {

    private List<Order>? orders;

    private int? expandedOrderId;

    private bool isLoading;

    private bool isAuthorized;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CheckAdminAccessAsync();

        if (!isAuthorized)
            return;

        await LoadData();
    }

    private async Task CheckAdminAccessAsync()
    {
        try
        {
            var authState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/Account/Login", true);
                return;
            }

            var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrWhiteSpace(userId))
            {
                Navigation.NavigateTo("/", true);
                return;
            }

            var currentUser = await Db.Users
                .AsNoTracking()
                .FirstOrDefaultAsync(x => x.Id == userId);

            if (currentUser == null || currentUser.Role != "Admin")
            {
                Navigation.NavigateTo("/", true);
                return;
            }

            isAuthorized = true;
        }
        catch
        {
            Navigation.NavigateTo("/", true);
        }
    }

    private async Task LoadData()
    {
        if (!isAuthorized)
            return;

        isLoading = true;
        errorMessage = null;

        try
        {
            orders = await Db.Orders
                .AsNoTracking()
                .Include(o => o.Items)
                    .ThenInclude(i => i.DocumentType)
                .OrderByDescending(o => o.CreatedAt)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"خطا در دریافت سفارش‌ها: {ex.GetBaseException().Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleDetails(int orderId)
    {
        expandedOrderId =
            expandedOrderId == orderId ? null : orderId;
    }

    private static string GetPaymentStatusTitle(string? status)
    {
        return status switch
        {
            "PendingPayment" => "در انتظار پرداخت",
            "Paid" => "پرداخت شده",
            "Failed" => "پرداخت ناموفق",
            "Refunded" => "مسترد شده",
            "Cancelled" => "لغو شده",
            _ => status ?? "نامشخص"
        };
    }

    private static string GetPaymentBadgeClass(string? status)
    {
        return status switch
        {
            "PendingPayment" => "bg-warning text-dark",
            "Paid" => "bg-success",
            "Failed" => "bg-danger",
            "Refunded" => "bg-info text-dark",
            "Cancelled" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private static string GetProgressStatusTitle(string? status)
    {
        return status switch
        {
            "Pending" => "در انتظار شروع",
            "InProgress" => "در حال ترجمه",
            "Completed" => "تکمیل شده",
            "Cancelled" => "لغو شده",
            _ => status ?? "نامشخص"
        };
    }

    private static string GetProgressBadgeClass(string? status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "InProgress" => "bg-primary",
            "Completed" => "bg-success",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private static string GetItemStatusTitle(string? status)
    {
        return status switch
        {
            "Pending" => "در انتظار شروع",
            "InProgress" => "در حال ترجمه",
            "Completed" => "تکمیل شده",
            _ => status ?? "نامشخص"
        };
    }

    private static string GetItemStatusBadgeClass(string? status)
    {
        return status switch
        {
            "Pending" => "bg-secondary",
            "InProgress" => "bg-primary",
            "Completed" => "bg-success",
            _ => "bg-secondary"
        };
    }
}
