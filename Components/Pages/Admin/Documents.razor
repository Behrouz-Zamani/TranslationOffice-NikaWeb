@* @layout AdminLayout *@
@page "/admin/documents"
@using TranslationOffice.Data
@using TranslationOffice.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@inject ApplicationDbContext Db
@inject DocumentSampleImageStorageService SampleImageStorage
@rendermode InteractiveServer

<h3 class="mb-4">مدیریت انواع اسناد و قیمت‌ها</h3>

@if (documents == null)
{
    <p>در حال بارگذاری...</p>
}
else
{
    <div class="mb-3">
        <button class="btn btn-success" @onclick="ShowAddForm">+ افزودن سند جدید</button>
    </div>

    @if (showForm)
    {
        <div class="card mb-4">
            <div class="card-header">
                @(editingItem == null ? "افزودن سند جدید" : "ویرایش سند")
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">نام مدرک</label>
                        <input class="form-control" @bind="form.Name" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">توضیحات مدرک</label>
                        <textarea class="form-control" rows="3" @bind="form.Description"
                                  placeholder="توضیح کوتاهی درباره این مدرک و خدمات ترجمه آن بنویسید..."></textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label">تصویر نمونه مدرک (اختیاری)</label>
                        <InputFile OnChange="OnSampleImageSelected" accept=".jpg,.jpeg,.png" class="form-control" />
                        <small class="text-muted d-block mt-1">فقط JPG یا PNG، حداکثر ۳ مگابایت. این تصویر برای نمایش به مشتری است و با فایل سفارش تفاوت دارد.</small>
                        @if (!string.IsNullOrWhiteSpace(form.SampleImagePath))
                        {
                            <div class="mt-2">
                                <img src="@form.SampleImagePath" alt="تصویر نمونه @form.Name" style="max-width:180px;max-height:140px;object-fit:contain;border:1px solid #ddd;border-radius:8px;padding:4px;" />
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedSampleImageName))
                        {
                            <div class="small text-success mt-2">تصویر انتخاب‌شده: @selectedSampleImageName (پس از ذخیره ثبت می‌شود)</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(imageError))
                        {
                            <div class="text-danger small mt-2">@imageError</div>
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">نوع قیمت‌گذاری</label>
                        <select class="form-select" @bind="form.PricingType">
                            <option value="@PricingType.Fixed">ثابت</option>
                            <option value="@PricingType.PerLine">بر اساس سطر</option>
                            <option value="@PricingType.PerPage">بر اساس صفحه</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">قیمت پایه (تومان)</label>
                        <input type="number" class="form-control" @bind="form.BasePrice" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">تعداد رایگان (سطر/صفحه)</label>
                        <input type="number" class="form-control" @bind="form.FreeUnits" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">قیمت هر واحد اضافی</label>
                        <input type="number" class="form-control" @bind="form.PricePerExtraUnit" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">قیمت نسخه اضافی</label>
                        <input type="number" class="form-control" @bind="form.ExtraCopyPrice" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">هزینه دادگستری</label>
                        <input type="number" class="form-control" @bind="form.JudiciaryFee" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">هزینه وزارت خارجه</label>
                        <input type="number" class="form-control" @bind="form.ForeignAffairsFee" />
                    </div>

                    <div class="col-md-4">
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" @bind="form.IsActive" id="isActive" />
                            <label class="form-check-label" for="isActive">فعال</label>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button class="btn btn-primary" @onclick="Save">ذخیره</button>
                    <button class="btn btn-secondary" @onclick="Cancel">انصراف</button>
                </div>
            </div>
        </div>
    }

    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>نام مدرک</th>
                <th>نوع قیمت</th>
                <th>قیمت پایه</th>
                <th>نسخه اضافی</th>
                <th>دادگستری</th>
                <th>خارجه</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doc in documents)
            {
                <tr>
                    <td>@doc.Name</td>
                    <td>
                        @switch (doc.PricingType)
                        {
                            case PricingType.Fixed:
                                <span>ثابت</span>
                                break;
                            case PricingType.PerLine:
                                <span>سطر</span>
                                break;
                            case PricingType.PerPage:
                                <span>صفحه</span>
                                break;
                        }
                    </td>
                    <td>@doc.BasePrice.ToString("N0")</td>
                    <td>@doc.ExtraCopyPrice.ToString("N0")</td>
                    <td>@doc.JudiciaryFee.ToString("N0")</td>
                    <td>@doc.ForeignAffairsFee.ToString("N0")</td>
                    <td>
                        @if (doc.IsActive)
                        {
                            <span class="badge bg-success">فعال</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">غیرفعال</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(doc)">ویرایش</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(doc)">حذف</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    List<DocumentType>? documents;
    bool showForm = false;
    DocumentType? editingItem;
    DocumentType form = new();
    IBrowserFile? selectedSampleImage;
    string? selectedSampleImageName;
    string? imageError;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        documents = await Db.DocumentTypes
            .OrderBy(x => x.Name)
            .ToListAsync();
    }

    void ShowAddForm()
    {
        editingItem = null;
        form = new DocumentType
        {
            IsActive = true,
            PricingType = PricingType.Fixed
        };
        selectedSampleImage = null;
        selectedSampleImageName = null;
        imageError = null;
        showForm = true;
    }

    void Edit(DocumentType doc)
    {
        editingItem = doc;
        form = new DocumentType
        {
            Id = doc.Id,
            Name = doc.Name,
            Description = doc.Description,
            SampleImagePath = doc.SampleImagePath,
            PricingType = doc.PricingType,
            BasePrice = doc.BasePrice,
            FreeUnits = doc.FreeUnits,
            PricePerExtraUnit = doc.PricePerExtraUnit,
            ExtraCopyPrice = doc.ExtraCopyPrice,
            JudiciaryFee = doc.JudiciaryFee,
            ForeignAffairsFee = doc.ForeignAffairsFee,
            IsActive = doc.IsActive
        };
        selectedSampleImage = null;
        selectedSampleImageName = null;
        imageError = null;
        showForm = true;
    }

    async Task OnSampleImageSelected(InputFileChangeEventArgs e)
    {
        imageError = null;
        selectedSampleImage = null;
        selectedSampleImageName = null;

        var file = e.File;
        var extension = Path.GetExtension(file.Name);
        if (!new[] { ".jpg", ".jpeg", ".png" }.Contains(extension, StringComparer.OrdinalIgnoreCase))
        {
            imageError = "فرمت تصویر باید JPG یا PNG باشد.";
            return;
        }

        if (file.Size <= 0 || file.Size > DocumentSampleImageStorageService.MaxFileSize)
        {
            imageError = "حجم تصویر باید بیشتر از صفر و حداکثر ۳ مگابایت باشد.";
            return;
        }

        selectedSampleImage = file;
        selectedSampleImageName = Path.GetFileName(file.Name);
    }

    async Task Save()
    {
        if (string.IsNullOrWhiteSpace(form.Name))
            return;

        imageError = null;
        string? newlySavedImagePath = null;
        var previousImagePath = editingItem?.SampleImagePath;

        try
        {
            if (selectedSampleImage != null)
            {
                await using var input = selectedSampleImage.OpenReadStream(
                    DocumentSampleImageStorageService.MaxFileSize);
                await using var memory = new MemoryStream();
                await input.CopyToAsync(memory);

                newlySavedImagePath = await SampleImageStorage.SaveAsync(
                    selectedSampleImage.Name,
                    memory.ToArray());

                form.SampleImagePath = newlySavedImagePath;
            }

            if (editingItem == null)
            {
                Db.DocumentTypes.Add(form);
            }
            else
            {
                var existing = await Db.DocumentTypes.FindAsync(editingItem.Id);
                if (existing != null)
                {
                    existing.Name = form.Name;
                    existing.Description = form.Description;
                    existing.SampleImagePath = form.SampleImagePath;
                    existing.PricingType = form.PricingType;
                    existing.BasePrice = form.BasePrice;
                    existing.FreeUnits = form.FreeUnits;
                    existing.PricePerExtraUnit = form.PricePerExtraUnit;
                    existing.ExtraCopyPrice = form.ExtraCopyPrice;
                    existing.JudiciaryFee = form.JudiciaryFee;
                    existing.ForeignAffairsFee = form.ForeignAffairsFee;
                    existing.IsActive = form.IsActive;
                }
            }

            await Db.SaveChangesAsync();

            if (!string.IsNullOrWhiteSpace(previousImagePath) &&
                previousImagePath != form.SampleImagePath)
            {
                await SampleImageStorage.DeleteAsync(previousImagePath);
            }

            showForm = false;
            selectedSampleImage = null;
            selectedSampleImageName = null;
            await LoadData();
        }
        catch (Exception ex)
        {
            if (!string.IsNullOrWhiteSpace(newlySavedImagePath))
                await SampleImageStorage.DeleteAsync(newlySavedImagePath);

            imageError = "ذخیره اطلاعات مدرک انجام نشد: " + ex.GetBaseException().Message;
        }
    }

    void Cancel()
    {
        showForm = false;
        editingItem = null;
        selectedSampleImage = null;
        selectedSampleImageName = null;
        imageError = null;
    }

    async Task Delete(DocumentType doc)
    {
        var existing = await Db.DocumentTypes.FindAsync(doc.Id);
        if (existing != null)
        {
            Db.DocumentTypes.Remove(existing);
            await Db.SaveChangesAsync();
            await LoadData();
        }
    }
}