@page "/"

<PageTitle>دارالترجمه رسمی | ثبت سفارش آنلاین</PageTitle>

<div class="home-page" dir="rtl">

    <!-- HERO SLIDER -->
    <section class="hero-section">

        <div id="homeHeroSlider"
             class="carousel slide carousel-fade"
             data-bs-ride="carousel"
             data-bs-interval="5500">

            <div class="carousel-indicators">
                <button type="button"
                        data-bs-target="#homeHeroSlider"
                        data-bs-slide-to="0"
                        class="active"
                        aria-current="true"
                        aria-label="اسلاید اول"></button>

                <button type="button"
                        data-bs-target="#homeHeroSlider"
                        data-bs-slide-to="1"
                        aria-label="اسلاید دوم"></button>

                <button type="button"
                        data-bs-target="#homeHeroSlider"
                        data-bs-slide-to="2"
                        aria-label="اسلاید سوم"></button>
            </div>

            <div class="carousel-inner">

                <!-- SLIDE 1 -->
                <div class="carousel-item active">
                    <div class="hero-slide hero-slide-one">
                        <div class="container">
                            <div class="row align-items-center">

                                <div class="col-lg-7">
                                    <div class="hero-content">

                                        <span class="hero-label">
                                            خدمات ترجمه رسمی آنلاین
                                        </span>

                                        <h1>
                                            ترجمه رسمی مدارک،
                                            <span>آسان‌تر از همیشه</span>
                                        </h1>

                                        <p>
                                            بدون مراجعه حضوری سفارش خود را ثبت کنید،
                                            هزینه را مشاهده کنید و مراحل ترجمه مدارک
                                            خود را به آسانی پیگیری کنید.
                                        </p>

                                        <div class="hero-actions">
                                            <a href="/order/create"
                                               class="btn hero-primary-btn">
                                                ثبت سفارش ترجمه
                                                <span>←</span>
                                            </a>

                                            <a href="#services"
                                               class="btn hero-secondary-btn">
                                                مشاهده خدمات
                                            </a>
                                        </div>

                                        <div class="hero-trust">
                                            <span>✓ ترجمه رسمی</span>
                                            <span>✓ قیمت شفاف</span>
                                            <span>✓ پیگیری سفارش</span>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-lg-5 d-none d-lg-block">
                                    <div class="hero-visual">

                                        <div class="visual-circle"></div>

                                        <div class="document-card document-card-main">
                                            <div class="document-icon">📄</div>
                                            <h5>ترجمه رسمی مدارک</h5>
                                            <p>ترجمه دقیق و معتبر</p>
                                            <div class="document-line"></div>
                                            <div class="document-line short"></div>
                                            <div class="document-line"></div>
                                            <div class="document-stamp">✓</div>
                                        </div>

                                        <div class="floating-card">
                                            <span>✓</span>
                                            <div>
                                                <strong>ثبت سفارش آنلاین</strong>
                                                <small>سریع و آسان</small>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- SLIDE 2 -->
                <div class="carousel-item">
                    <div class="hero-slide hero-slide-two">
                        <div class="container">
                            <div class="row align-items-center">

                                <div class="col-lg-8">
                                    <div class="hero-content">

                                        <span class="hero-label">
                                            شفافیت در هزینه‌ها
                                        </span>

                                        <h1>
                                            قبل از ثبت سفارش،
                                            <span>قیمت را بدانید</span>
                                        </h1>

                                        <p>
                                            نوع مدرک، تعداد صفحات و تأییدات مورد نیاز
                                            را انتخاب کنید و هزینه سفارش خود را
                                            به صورت خودکار مشاهده کنید.
                                        </p>

                                        <div class="hero-actions">
                                            <a href="/order/create"
                                               class="btn hero-primary-btn">
                                                محاسبه قیمت و ثبت سفارش
                                                <span>←</span>
                                            </a>
                                        </div>

                                        <div class="hero-trust">
                                            <span>✓ محاسبه خودکار</span>
                                            <span>✓ جزئیات شفاف</span>
                                            <span>✓ بدون هزینه پنهان</span>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-lg-4 d-none d-lg-block">
                                    <div class="price-visual">
                                        <div class="price-icon">💰</div>
                                        <span>محاسبه هزینه ترجمه</span>
                                        <div class="price-divider"></div>
                                        <div class="price-row">
                                            <span>ترجمه مدرک</span>
                                            <strong>محاسبه خودکار</strong>
                                        </div>
                                        <div class="price-row">
                                            <span>تأییدات رسمی</span>
                                            <strong>انتخابی</strong>
                                        </div>
                                        <div class="price-total">
                                            هزینه نهایی سفارش
                                            <strong>شفاف و مشخص</strong>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- SLIDE 3 -->
                <div class="carousel-item">
                    <div class="hero-slide hero-slide-three">
                        <div class="container">
                            <div class="row align-items-center">

                                <div class="col-lg-8">
                                    <div class="hero-content">

                                        <span class="hero-label">
                                            همراه شما تا تحویل نهایی
                                        </span>

                                        <h1>
                                            سفارش خود را
                                            <span>لحظه‌به‌لحظه پیگیری کنید</span>
                                        </h1>

                                        <p>
                                            از زمان ثبت سفارش تا انجام ترجمه و دریافت
                                            فایل‌های نهایی، وضعیت سفارش خود را
                                            از پنل کاربری دنبال کنید.
                                        </p>

                                        <div class="hero-actions">
                                            <a href="/account/orders"
                                               class="btn hero-primary-btn">
                                                مشاهده سفارش‌های من
                                                <span>←</span>
                                            </a>

                                            <a href="/order/create"
                                               class="btn hero-secondary-btn">
                                                ثبت سفارش جدید
                                            </a>
                                        </div>

                                        <div class="hero-trust">
                                            <span>✓ پیگیری آسان</span>
                                            <span>✓ اطلاع از وضعیت</span>
                                            <span>✓ دریافت فایل نهایی</span>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-lg-4 d-none d-lg-block">
                                    <div class="tracking-visual">
                                        <div class="tracking-title">
                                            <span>وضعیت سفارش</span>
                                            <strong>در حال انجام</strong>
                                        </div>

                                        <div class="tracking-step done">
                                            <span>✓</span>
                                            <div>
                                                <strong>ثبت سفارش</strong>
                                                <small>سفارش دریافت شد</small>
                                            </div>
                                        </div>

                                        <div class="tracking-step done">
                                            <span>✓</span>
                                            <div>
                                                <strong>بررسی مدارک</strong>
                                                <small>اطلاعات بررسی شد</small>
                                            </div>
                                        </div>

                                        <div class="tracking-step current">
                                            <span>●</span>
                                            <div>
                                                <strong>ترجمه مدارک</strong>
                                                <small>در حال انجام</small>
                                            </div>
                                        </div>

                                        <div class="tracking-step">
                                            <span>4</span>
                                            <div>
                                                <strong>تحویل نهایی</strong>
                                                <small>مرحله بعدی</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <button class="carousel-control-prev"
                    type="button"
                    data-bs-target="#homeHeroSlider"
                    data-bs-slide="prev"
                    aria-label="اسلاید قبلی">
                <span class="carousel-control-prev-icon"></span>
            </button>

            <button class="carousel-control-next"
                    type="button"
                    data-bs-target="#homeHeroSlider"
                    data-bs-slide="next"
                    aria-label="اسلاید بعدی">
                <span class="carousel-control-next-icon"></span>
            </button>

        </div>

    </section>

    <div class="container">

        <!-- FEATURES -->
        <section id="services" class="features-section">

            <div class="section-heading">
                <span>خدمات ما</span>
                <h2>چرا دارالترجمه ما؟</h2>
                <p>
                    تجربه‌ای ساده، مطمئن و حرفه‌ای برای ترجمه مدارک شما
                </p>
            </div>

            <div class="row g-4">

                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon teal">📋</div>
                        <h5>انتخاب آسان مدرک</h5>
                        <p>
                            انواع مدارک تحصیلی، هویتی، شرکتی و قراردادی
                            در دسترس شماست.
                        </p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon gold">💰</div>
                        <h5>قیمت شفاف</h5>
                        <p>
                            محاسبه خودکار هزینه بر اساس نوع مدرک،
                            تعداد صفحات و تأییدات.
                        </p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon blue">⏱️</div>
                        <h5>پیگیری سفارش</h5>
                        <p>
                            از ثبت سفارش تا تحویل نهایی،
                            وضعیت کار خود را پیگیری کنید.
                        </p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon green">✓</div>
                        <h5>تأییدات رسمی</h5>
                        <p>
                            امکان انتخاب تأیید دادگستری و
                            وزارت امور خارجه.
                        </p>
                    </div>
                </div>

            </div>

        </section>

        <!-- HOW IT WORKS -->
        <section class="steps-section">

            <div class="section-heading">
                <span>شروع آسان</span>
                <h2>چطور سفارش ثبت کنیم؟</h2>
                <p>فقط در چهار مرحله سفارش خود را ثبت کنید.</p>
            </div>

            <div class="row g-4">

                <div class="col-md-6 col-lg-3">
                    <div class="step-card">
                        <div class="step-number">۱</div>
                        <h6>انتخاب مدرک</h6>
                        <p>نوع سند مورد نظر خود را انتخاب کنید.</p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="step-card">
                        <div class="step-number">۲</div>
                        <h6>تعیین جزئیات</h6>
                        <p>تعداد صفحات و تأییدات را مشخص کنید.</p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="step-card">
                        <div class="step-number">۳</div>
                        <h6>مشاهده قیمت</h6>
                        <p>هزینه سفارش به صورت خودکار محاسبه می‌شود.</p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="step-card">
                        <div class="step-number">۴</div>
                        <h6>ثبت سفارش</h6>
                        <p>سفارش خود را نهایی و پیگیری کنید.</p>
                    </div>
                </div>

            </div>

        </section>

        <!-- INFORMATION -->
        <section class="info-section">

            <div class="row g-4">

                <div class="col-lg-6">
                    <div class="info-card">
                        <h5>نکات مهم</h5>

                        <ul>
                            <li>قیمت‌ها بر اساس تنظیمات و نرخ‌های سیستم محاسبه می‌شوند.</li>
                            <li>برخی مدارک بر اساس تعداد سطر یا صفحه قیمت‌گذاری می‌شوند.</li>
                            <li>تأیید دادگستری و وزارت خارجه به صورت جداگانه قابل انتخاب است.</li>
                            <li>پس از ثبت سفارش، وضعیت آن قابل پیگیری خواهد بود.</li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="info-card info-card-highlight">
                        <span class="info-badge">شروع سریع</span>
                        <h3>آماده ثبت سفارش هستید؟</h3>
                        <p>
                            همین حالا مدارک خود را انتخاب کنید و
                            سفارش ترجمه را به صورت آنلاین ثبت کنید.
                        </p>

                        <a href="/order/create" class="btn info-btn">
                            شروع ثبت سفارش
                            <span>←</span>
                        </a>
                    </div>
                </div>

            </div>

        </section>

    </div>

</div>
