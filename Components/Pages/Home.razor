@page "/"

<PageTitle>دارالترجمه رسمی | ترجمه دقیق، اعتماد ماندگار</PageTitle>

<HeadContent>
    <link href="/css/home.css" rel="stylesheet" />
</HeadContent>

<div class="home-page" dir="rtl">

    <!-- HERO -->
    <section class="hero-section">
        <div class="hero-glow hero-glow-one"></div>
        <div class="hero-glow hero-glow-two"></div>

        <div class="home-container hero-grid">

            <div class="hero-content">

                <div class="hero-eyebrow">
                    <span class="eyebrow-dot"></span>
                    خدمات ترجمه رسمی و تخصصی
                </div>

                <h1>
                    مدارک شما،
                    <span>با دقت و اطمینان</span>
                    به زبان جهان
                </h1>

                <p class="hero-description">
                    سفارش ترجمه رسمی مدارک خود را به‌سادگی ثبت کنید.
                    از ثبت درخواست تا دریافت ترجمه، تمام مراحل را
                    به‌صورت آنلاین و شفاف پیگیری کنید.
                </p>

                <div class="hero-actions">
                    <a href="/order/create" class="hero-primary-btn">
                        ثبت سفارش ترجمه
                        <span>←</span>
                    </a>

                    <a href="/account/orders" class="hero-secondary-btn">
                        پیگیری سفارش
                        <span>↗</span>
                    </a>
                </div>

                <div class="hero-trust">
                    <div class="trust-avatars">
                        <span>ت</span>
                        <span>م</span>
                        <span>ر</span>
                    </div>
                    <div>
                        <strong>فرآیند ساده و آنلاین</strong>
                        <small>از ثبت درخواست تا پیگیری سفارش</small>
                    </div>
                </div>

            </div>

            <div class="hero-visual">

                <div class="visual-orbit orbit-one"></div>
                <div class="visual-orbit orbit-two"></div>

                <div class="document-card">

                    <div class="document-top">
                        <div class="document-brand">
                            <span class="document-brand-icon">ت</span>
                            <div>
                                <strong>دارالترجمه رسمی</strong>
                                <small>OFFICIAL TRANSLATION</small>
                            </div>
                        </div>

                        <span class="document-status">نمونه سند</span>
                    </div>

                    <div class="document-heading">
                        <span class="document-line short"></span>
                        <strong>گواهی ترجمه</strong>
                        <span class="document-line"></span>
                    </div>

                    <div class="document-seal">
                        <div class="seal-inner">
                            <span>ت</span>
                            <small>OFFICIAL</small>
                        </div>
                    </div>

                    <div class="document-lines">
                        <span></span>
                        <span></span>
                        <span class="medium"></span>
                        <span></span>
                        <span class="short"></span>
                    </div>

                    <div class="document-signature">
                        <span>امضا و تأیید</span>
                        <strong>✓</strong>
                    </div>

                    <div class="document-footer">
                        <span>ترجمه دقیق</span>
                        <span>اعتماد ماندگار</span>
                    </div>

                </div>

                <div class="floating-card floating-card-top">
                    <span class="floating-icon">✓</span>
                    <div>
                        <strong>ثبت آنلاین سفارش</strong>
                        <small>سریع و آسان</small>
                    </div>
                </div>

                <div class="floating-card floating-card-bottom">
                    <span class="floating-icon">↗</span>
                    <div>
                        <strong>پیگیری مرحله‌ای</strong>
                        <small>مشاهده وضعیت سفارش</small>
                    </div>
                </div>

                <div class="visual-decoration decoration-one"></div>
                <div class="visual-decoration decoration-two"></div>

            </div>
        </div>

        <div class="hero-bottom-line"></div>
    </section>


    <!-- QUICK FEATURES -->
    <section class="quick-features">
        <div class="home-container quick-features-grid">

            <div class="quick-feature">
                <span class="quick-feature-icon">⌁</span>
                <div>
                    <strong>ثبت سفارش آنلاین</strong>
                    <small>بدون مراجعه اولیه</small>
                </div>
            </div>

            <div class="quick-feature">
                <span class="quick-feature-icon">◷</span>
                <div>
                    <strong>پیگیری سفارش</strong>
                    <small>مشاهده وضعیت درخواست</small>
                </div>
            </div>

            <div class="quick-feature">
                <span class="quick-feature-icon">▤</span>
                <div>
                    <strong>مدیریت مدارک</strong>
                    <small>دسترسی به اسناد سفارش</small>
                </div>
            </div>

            <div class="quick-feature">
                <span class="quick-feature-icon">✓</span>
                <div>
                    <strong>فرآیند شفاف</strong>
                    <small>اطلاع از مراحل انجام کار</small>
                </div>
            </div>

        </div>
    </section>


    <!-- SERVICES -->
    <section class="services-section">
        <div class="home-container">

            <div class="section-heading">
                <div class="section-kicker">خدمات ما</div>
                <h2>چه مدارکی را می‌توانید ترجمه کنید؟</h2>
                <p>
                    درخواست ترجمه مدارک خود را در چند مرحله ساده ثبت کنید
                    و روند انجام آن را از طریق پنل کاربری دنبال کنید.
                </p>
            </div>

            <div class="services-grid">

                <article class="service-card">
                    <div class="service-icon service-icon-blue">
                        <span>▤</span>
                    </div>
                    <div class="service-card-content">
                        <span class="service-number">01</span>
                        <h3>مدارک هویتی</h3>
                        <p>
                            ترجمه مدارک شناسایی و اسناد مربوط به هویت
                            و وضعیت شخصی.
                        </p>
                    </div>
                    <a href="/order/create" class="service-link">
                        ثبت درخواست <span>←</span>
                    </a>
                </article>

                <article class="service-card featured-service">
                    <div class="service-icon service-icon-teal">
                        <span>▧</span>
                    </div>
                    <div class="service-card-content">
                        <span class="service-number">02</span>
                        <h3>مدارک تحصیلی</h3>
                        <p>
                            ترجمه مدارک دانشگاهی، گواهی‌ها و
                            اسناد آموزشی.
                        </p>
                    </div>
                    <a href="/order/create" class="service-link">
                        ثبت درخواست <span>←</span>
                    </a>
                </article>

                <article class="service-card">
                    <div class="service-icon service-icon-purple">
                        <span>▣</span>
                    </div>
                    <div class="service-card-content">
                        <span class="service-number">03</span>
                        <h3>اسناد و مدارک رسمی</h3>
                        <p>
                            ثبت درخواست ترجمه انواع اسناد و
                            مدارک رسمی و اداری.
                        </p>
                    </div>
                    <a href="/order/create" class="service-link">
                        ثبت درخواست <span>←</span>
                    </a>
                </article>

            </div>

            <div class="services-bottom">
                <span>برای شروع، کافی است درخواست خود را ثبت کنید.</span>
                <a href="/order/create">
                    شروع ثبت سفارش
                    <span>←</span>
                </a>
            </div>

        </div>
    </section>


    <!-- PROCESS -->
    <section class="process-section">
        <div class="home-container">

            <div class="section-heading">
                <div class="section-kicker">فرآیند انجام سفارش</div>
                <h2>از درخواست تا دریافت ترجمه</h2>
                <p>
                    مسیر انجام سفارش شما ساده، مشخص و قابل پیگیری است.
                </p>
            </div>

            <div class="process-grid">

                <div class="process-step">
                    <div class="process-number">۱</div>
                    <div class="process-icon">＋</div>
                    <h3>ثبت سفارش</h3>
                    <p>
                        اطلاعات اولیه سفارش و مدارک موردنیاز را ثبت کنید.
                    </p>
                </div>

                <div class="process-connector"></div>

                <div class="process-step">
                    <div class="process-number">۲</div>
                    <div class="process-icon">▤</div>
                    <h3>بررسی مدارک</h3>
                    <p>
                        درخواست و مدارک شما توسط مجموعه بررسی می‌شود.
                    </p>
                </div>

                <div class="process-connector"></div>

                <div class="process-step">
                    <div class="process-number">۳</div>
                    <div class="process-icon">✎</div>
                    <h3>انجام ترجمه</h3>
                    <p>
                        سفارش برای انجام مراحل ترجمه در جریان قرار می‌گیرد.
                    </p>
                </div>

                <div class="process-connector"></div>

                <div class="process-step">
                    <div class="process-number">۴</div>
                    <div class="process-icon">✓</div>
                    <h3>تحویل سفارش</h3>
                    <p>
                        وضعیت نهایی سفارش را مشاهده و مدارک را دریافت کنید.
                    </p>
                </div>

            </div>

        </div>
    </section>


    <!-- WHY US -->
    <section class="why-section">
        <div class="home-container why-grid">

            <div class="why-content">
                <div class="section-kicker">تجربه‌ای ساده‌تر</div>
                <h2>
                    مدیریت ترجمه‌ها،
                    <span>بدون سردرگمی</span>
                </h2>

                <p>
                    سامانه آنلاین دارالترجمه به شما کمک می‌کند
                    درخواست‌های خود را ثبت کنید، مدارک را ارسال کنید
                    و از آخرین وضعیت سفارش‌هایتان مطلع شوید.
                </p>

                <div class="why-list">
                    <div>
                        <span>✓</span>
                        <div>
                            <strong>دسترسی به سفارش‌ها</strong>
                            <small>مشاهده درخواست‌های ثبت‌شده در پنل کاربری</small>
                        </div>
                    </div>

                    <div>
                        <span>✓</span>
                        <div>
                            <strong>بارگذاری مدارک</strong>
                            <small>ارسال فایل‌های مرتبط با سفارش</small>
                        </div>
                    </div>

                    <div>
                        <span>✓</span>
                        <div>
                            <strong>اطلاع از وضعیت ترجمه</strong>
                            <small>پیگیری روند انجام سفارش</small>
                        </div>
                    </div>
                </div>

                <a href="/order/create" class="why-button">
                    ثبت سفارش جدید
                    <span>←</span>
                </a>
            </div>

            <div class="why-visual">
                <div class="dashboard-card">

                    <div class="dashboard-header">
                        <div>
                            <small>پنل کاربری</small>
                            <strong>مدیریت سفارش‌ها</strong>
                        </div>
                        <span class="dashboard-avatar">ک</span>
                    </div>

                    <div class="dashboard-welcome">
                        <span>خوش آمدید</span>
                        <strong>سفارش‌های شما</strong>
                    </div>

                    <div class="dashboard-order">
                        <div class="dashboard-order-icon">▤</div>
                        <div class="dashboard-order-info">
                            <strong>درخواست ترجمه</strong>
                            <small>مشاهده جزئیات سفارش</small>
                        </div>
                        <span class="dashboard-arrow">←</span>
                    </div>

                    <div class="dashboard-order">
                        <div class="dashboard-order-icon second">▧</div>
                        <div class="dashboard-order-info">
                            <strong>مدارک ارسالی</strong>
                            <small>مدیریت فایل‌ها</small>
                        </div>
                        <span class="dashboard-arrow">←</span>
                    </div>

                    <div class="dashboard-progress">
                        <div class="dashboard-progress-title">
                            <strong>روند انجام سفارش</strong>
                            <span>قابل پیگیری</span>
                        </div>
                        <div class="progress-track">
                            <span></span>
                        </div>
                        <small>مشاهده آخرین وضعیت از پنل کاربری</small>
                    </div>

                </div>

                <div class="dashboard-decoration"></div>
            </div>

        </div>
    </section>


    <!-- CTA -->
    <section class="final-cta-section">
        <div class="home-container">
            <div class="final-cta">

                <div class="cta-decoration cta-decoration-one"></div>
                <div class="cta-decoration cta-decoration-two"></div>

                <div class="cta-content">
                    <span class="cta-kicker">شروع یک مسیر ساده</span>
                    <h2>برای ترجمه مدارکتان آماده‌اید؟</h2>
                    <p>
                        همین حالا درخواست خود را ثبت کنید و مراحل سفارش
                        را به‌صورت آنلاین دنبال کنید.
                    </p>
                </div>

                <a href="/order/create" class="cta-button">
                    ثبت سفارش آنلاین
                    <span>←</span>
                </a>

            </div>
        </div>
    </section>

</div>
