@page "/account/orders"

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using TranslationOffice.Data
@using TranslationOffice.Models

@attribute [Authorize]
@rendermode InteractiveServer

@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>سفارش‌های من</PageTitle>

<h3 class="mb-4">سفارش‌های من</h3>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2">در حال دریافت سفارش‌ها...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (orders.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h5>هنوز سفارشی ثبت نکرده‌اید.</h5>
            <p class="text-muted">برای ثبت سفارش ترجمه از دکمه زیر استفاده کنید.</p>

            <a href="/order/create" class="btn btn-primary">
                ثبت سفارش جدید
            </a>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted">
            تعداد سفارش‌ها: @orders.Count
        </span>

        <a href="/order/create" class="btn btn-primary">
            ثبت سفارش جدید
        </a>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>شماره سفارش</th>
                        <th>تاریخ ثبت</th>
                        <th>تعداد مدارک</th>
                        <th>مبلغ کل</th>
                        <th>وضعیت پرداخت</th>
                        <th>وضعیت ترجمه</th>
                        <th>جزئیات</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in orders)
                    {
                        <tr>
                            <td class="fw-bold">
                                @order.OrderNumber
                            </td>

                            <td>
                                @order.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                            </td>

                            <td>
                                @order.Items.Count
                            </td>

                            <td class="text-nowrap">
                                @order.TotalPrice.ToString("N0")
                                تومان
                            </td>

                            <td>
                                <span class="badge @GetPaymentStatusClass(order.Status)">
                                    @GetPaymentStatusText(order.Status)
                                </span>
                            </td>

                            <td>
                                <span class="badge @GetProgressStatusClass(order.ProgressStatus)">
                                    @GetProgressStatusText(order.ProgressStatus)
                                </span>
                            </td>

                            <td>
                                <a href="@($"/account/orders/{order.Id}")"
                                   class="btn btn-sm btn-outline-primary">
                                    مشاهده جزئیات
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Order> orders = new();

    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/Account/Login", true);
                return;
            }

            var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);

            if (string.IsNullOrWhiteSpace(userId))
            {
                errorMessage = "اطلاعات حساب کاربری قابل شناسایی نیست.";
                return;
            }

            orders = await Db.Orders
                .AsNoTracking()
                .Where(x => x.UserId == userId)
                .Include(x => x.Items)
                .OrderByDescending(x => x.CreatedAt)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"خطا در دریافت سفارش‌ها: {ex.GetBaseException().Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetPaymentStatusText(string? status)
    {
        return status switch
        {
            "PendingPayment" => "در انتظار پرداخت",
            "Paid" => "پرداخت‌شده",
            "Failed" => "پرداخت ناموفق",
            "Refunded" => "مستردشده",
            "Cancelled" => "لغوشده",
            _ => status ?? "نامشخص"
        };
    }

    private static string GetPaymentStatusClass(string? status)
    {
        return status switch
        {
            "Paid" => "bg-success",
            "PendingPayment" => "bg-warning text-dark",
            "Failed" => "bg-danger",
            "Refunded" => "bg-info text-dark",
            "Cancelled" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private static string GetProgressStatusText(string? status)
    {
        return status switch
        {
            "Pending" => "در انتظار شروع",
            "InProgress" => "در حال ترجمه",
            "Completed" => "تکمیل‌شده",
            "Cancelled" => "لغوشده",
            _ => status ?? "نامشخص"
        };
    }

    private static string GetProgressStatusClass(string? status)
    {
        return status switch
        {
            "Completed" => "bg-success",
            "InProgress" => "bg-primary",
            "Pending" => "bg-warning text-dark",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
