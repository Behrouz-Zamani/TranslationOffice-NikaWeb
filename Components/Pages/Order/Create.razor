@page "/order/create"
@page "/order/product/{DocumentId:int}"

@using System.IO
@using System.Text.Json
@using TranslationOffice.Data
@using TranslationOffice.Models
@using TranslationOffice.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject ApplicationDbContext Db
@inject PricingService Pricing
@inject OrderDocumentStorageService DocumentStorage
@inject NavigationManager Navigation
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="order-page-heading mb-4">
    <div>
        <span class="order-eyebrow">NIKA TRANSLATION</span>
        <h3 class="mb-1">ثبت سفارش ترجمه رسمی</h3>
        <p class="text-muted mb-0">مدرک موردنظر را انتخاب کنید و جزئیات سفارش را ثبت کنید.</p>
    </div>
    <div class="order-step-indicator">
        <span class="@(DocumentId.HasValue ? "" : "active")">۱. انتخاب مدرک</span>
        <span class="@(DocumentId.HasValue ? "active" : "")">۲. ثبت جزئیات</span>
        <span>۳. ثبت سفارش</span>
    </div>
</div>

@if (documents == null || !isCartLoaded)
{
    <p class="text-center my-5">در حال بارگذاری اطلاعات...</p>
}
else
{
    @if (activeOrderId.HasValue)
    {
        <div class="alert alert-info">
            <strong>سفارش مهمان فعال:</strong>
            اطلاعات جدید به سفارش شماره
            <strong>@activeOrderNumber</strong>
            اضافه خواهد شد.
            <br />
            تا زمانی که سفارش را به حساب کاربری متصل نکرده‌اید،
            اطلاعات آن در این مرورگر نگهداری می‌شود.
        </div>
    }

    <div class="row">

<div class="col-lg-7">
            @if (DocumentId.HasValue && selectedDoc != null)
            {
                <div class="order-detail-card">
                    <button type="button" class="btn btn-link order-back-link px-0 mb-3" @onclick="BackToProducts">
                        <i class="bi bi-arrow-right ms-1"></i> بازگشت به فهرست مدارک
                    </button>
                    <div class="order-detail-hero">
                        @if (!string.IsNullOrWhiteSpace(selectedDoc.SampleImagePath))
                        {
                            <img class="order-document-sample-image" src="@selectedDoc.SampleImagePath" alt="نمونه @selectedDoc.Name" />
                        }
                        else
                        {
                            <div class="order-product-icon large"><i class="@GetDocumentIcon(selectedDoc)"></i></div>
                        }
                        <div>
                            <span class="order-eyebrow">جزئیات مدرک انتخابی</span>
                            <h4 class="mb-2">@selectedDoc.Name</h4>
                            <span class="order-type-pill">@GetPricingTypeText(selectedDoc)</span>
                        </div>
                    </div>
                    <div class="order-description-box mt-4">
                        <h6><i class="bi bi-info-circle ms-2"></i>درباره این مدرک</h6>
                        <p class="mb-0">@GetDocumentDescription(selectedDoc)</p>
                    </div>
                    <div class="order-options-section mt-4">
                        <h5 class="mb-3">تنظیمات و گزینه‌های سفارش</h5>
                        @if (selectedDoc.PricingType != PricingType.Fixed)
                        {
                            <div class="mb-3">
                                <label class="form-label">@(selectedDoc.PricingType == PricingType.PerLine ? "تعداد سطر" : "تعداد صفحه")</label>
                                <input type="number" class="form-control order-option-input" value="@units" @oninput="OnUnitsChanged" min="1" />
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label">تعداد نسخه</label>
                            <input type="number" class="form-control order-option-input" value="@quantity" @oninput="OnQuantityChanged" min="1" />
                        </div>
                        <div class="order-extra-options">
                            <label class="order-option-check">
                                <input type="checkbox" checked="@needJudiciary" @onchange="OnJudiciaryChanged" />
                                <span><strong>تأیید دادگستری</strong><small>در صورت نیاز، تأییدیه دادگستری نیز دریافت شود.</small></span>
                                <b>@selectedDoc.JudiciaryFee.ToString("N0") تومان</b>
                            </label>
                            <label class="order-option-check">
                                <input type="checkbox" checked="@needForeignAffairs" @onchange="OnForeignChanged" />
                                <span><strong>تأیید وزارت امور خارجه</strong><small>در صورت نیاز، تأییدیه وزارت امور خارجه نیز دریافت شود.</small></span>
                                <b>@selectedDoc.ForeignAffairsFee.ToString("N0") تومان</b>
                            </label>
                        </div>
                    </div>
                    <div class="order-upload-box mt-4">
                        <h6 class="mb-2"><i class="bi bi-cloud-arrow-up ms-2"></i>بارگذاری فایل مدرک</h6>
                        <p class="text-muted small mb-3">تصویر یا فایل مدرک را برای بررسی و ترجمه بارگذاری کنید.</p>
                        <InputFile OnChange="OnFilesSelected" multiple accept=".pdf,.jpg,.jpeg,.png" class="form-control" disabled="@isSubmitting" />
                        <small class="text-muted d-block mt-2">فرمت‌های مجاز: PDF، JPG، JPEG و PNG؛ حداکثر ۱۰ مگابایت برای هر فایل، حداکثر ۱۰ فایل و مجموعاً ۳۰ مگابایت برای هر مدرک.</small>
                        @if (selectedFiles.Any())
                        {
                            <ul class="list-group list-group-flush mt-3">
                                @foreach (var file in selectedFiles)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span class="text-break">@file.Name <small class="text-muted">(@FormatFileSize(file.Size))</small></span>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveSelectedFile(file)">حذف</button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="order-price-summary mt-4">
                        <div><span>مبلغ این مدرک</span><small>بر اساس گزینه‌های انتخاب‌شده</small></div>
                        <strong>@currentPrice.ToString("N0") <small>تومان</small></strong>
                    </div>
                    <button type="button" class="btn order-add-button w-100 mt-3" @onclick="AddToCart" disabled="@isSubmitting">
                        <i class="bi bi-cart-plus ms-2"></i> افزودن به سبد سفارش
                    </button>
                </div>
            }
            else if (!DocumentId.HasValue)
            {
                <div class="order-products-heading mb-3">
                    <div><h5 class="mb-1">چه مدرکی برای ترجمه دارید؟</h5><p class="text-muted mb-0 small">برای مشاهده توضیحات و گزینه‌های هر مدرک، کارت آن را انتخاب کنید.</p></div>
                    <span class="order-count">@documents.Count مورد</span>
                </div>
                <div class="row g-3">
                    @foreach (var doc in documents)
                    {
                        <div class="col-md-6">
                            <button type="button" class="order-product-card w-100 text-start" @onclick="() => GoToProduct(doc)">
                                <div class="order-product-card-top">
                                    @if (!string.IsNullOrWhiteSpace(doc.SampleImagePath))
                                    {
                                        <img class="order-product-card-image" src="@doc.SampleImagePath" alt="نمونه @doc.Name" />
                                    }
                                    else
                                    {
                                        <div class="order-product-icon"><i class="@GetDocumentIcon(doc)"></i></div>
                                    }
                                    <span class="order-card-arrow"><i class="bi bi-arrow-left"></i></span>
                                </div>
                                <h6>@doc.Name</h6>
                                <p>@GetDocumentShortDescription(doc)</p>
                                <div class="order-product-card-bottom">
                                    <span>@GetPricingTypeText(doc)</span>
                                    <strong>از @doc.BasePrice.ToString("N0") تومان</strong>
                                </div>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning">مدرک موردنظر پیدا نشد یا در حال حاضر فعال نیست.</div>
                <button type="button" class="btn btn-outline-secondary" @onclick="BackToProducts">بازگشت به فهرست مدارک</button>
            }
        </div>

                <div class="col-lg-5">
            <div class="card mb-4">

                <div class="card-header">
                    سبد سفارش
                </div>

                <div class="card-body">

                    @if (cart.Any())
                    {
                        @foreach (var item in cart)
                        {
                            <div class="border rounded p-3 mb-3">

                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                                    <strong>@item.DocumentName</strong>

                                    @if (item.IsSubmitted)
                                    {
                                        <span class="badge bg-success">
                                            ثبت‌شده در سفارش
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                @onclick="() => RemoveFromCart(item)"
                                                disabled="@isSubmitting">
                                            حذف
                                        </button>
                                    }

                                </div>

                                <div class="small text-muted mt-2">
                                    تعداد نسخه: @item.Quantity
                                    <br />
                                    تعداد سطر/صفحه: @item.Units
                                    <br />
                                    دادگستری: @(item.NeedJudiciary ? "بله" : "خیر")
                                    <br />
                                    وزارت خارجه: @(item.NeedForeignAffairs ? "بله" : "خیر")
                                </div>

                                <div class="mt-2">
                                    <strong>مبلغ:</strong>
                                    @item.TotalPrice.ToString("N0") تومان
                                </div>

                                <div class="mt-2">
                                    <strong>فایل‌های پیوست:</strong>

                                    @if (item.Files.Any())
                                    {
                                        <ul class="small mb-0 mt-1">
                                            @foreach (var file in item.Files)
                                            {
                                                <li>
                                                    @file.Name
                                                    (@FormatFileSize(file.Size))
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">
                                            فایلی پیوست نشده است.
                                        </div>
                                    }
                                </div>

                            </div>
                        }

                        <div class="alert alert-success d-flex justify-content-between">
                            <strong>جمع کل سفارش:</strong>

                            <span class="fw-bold">
                                @cart.Sum(x => x.TotalPrice).ToString("N0") تومان
                            </span>
                        </div>

                        @if (cart.Any(x => !x.IsSubmitted))
                        {
                            <button type="button"
                                    class="btn btn-success w-100"
                                    @onclick="SubmitOrder"
                                    disabled="@isSubmitting">

                                @(isSubmitting
                                    ? "در حال ثبت اطلاعات..."
                                    : activeOrderId.HasValue
                                        ? "افزودن اطلاعات جدید به همین سفارش"
                                        : "ثبت نهایی سفارش")
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-success">
                                تمام اقلام این سبد قبلاً در سفارش ثبت شده‌اند.
                                می‌توانید مدارک جدید اضافه کنید.
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center my-4">
                            سبد سفارش خالی است.
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger mt-3">
                            <strong>خطا:</strong>
                            <div class="mt-1">@errorMessage</div>
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>
}

@code {
    private const long MaxFileSize = 10 * 1024 * 1024;
    private const long MaxTotalFileSizePerDocument = 30 * 1024 * 1024;
    private const int MaxFilesPerDocument = 10;

    private static readonly HashSet<string> AllowedExtensions =
        new(StringComparer.OrdinalIgnoreCase)
        {
            ".pdf", ".jpg", ".jpeg", ".png"
        };

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    [Parameter]
    public int? DocumentId { get; set; }

    private List<DocumentType>? documents;
    private DocumentType? selectedDoc;

    private int units = 1;
    private int quantity = 1;

    private bool needJudiciary;
    private bool needForeignAffairs;

    private decimal currentPrice;

    private bool isSubmitting;
    private bool isCartLoaded;

    private string? errorMessage;

    private string? activeOrderNumber;
    private int? activeOrderId;
    private string? activeGuestToken;

    private List<UploadedFileData> selectedFiles = new();
    private List<CartItem> cart = new();

    private IJSObjectReference? cartStorage;

    protected override async Task OnInitializedAsync()
    {
        documents = await Db.DocumentTypes
            .AsNoTracking()
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

    }

    protected override void OnParametersSet()
    {
        if (documents == null)
            return;

        if (DocumentId.HasValue)
        {
            var nextDocument = documents.FirstOrDefault(x => x.Id == DocumentId.Value);

            if (nextDocument == null)
            {
                selectedDoc = null;
                errorMessage = "مدرک موردنظر پیدا نشد یا در حال حاضر فعال نیست.";
                currentPrice = 0;
                return;
            }

            if (selectedDoc?.Id != nextDocument.Id)
            {
                selectedFiles.Clear();
                units = 1;
                quantity = 1;
                needJudiciary = false;
                needForeignAffairs = false;
                errorMessage = null;
            }

            selectedDoc = nextDocument;
            CalculatePrice();
        }
        else
        {
            selectedDoc = null;
            currentPrice = 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            cartStorage = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/orderCartStorage.js");

            var savedJson = await cartStorage.InvokeAsync<string?>("loadCart");

            if (!string.IsNullOrWhiteSpace(savedJson))
            {
                var state = JsonSerializer.Deserialize<GuestCartState>(
                    savedJson,
                    JsonOptions);

                if (state != null)
                {
                    cart = state.Items ?? new List<CartItem>();
                    activeOrderId = state.OrderId;
                    activeGuestToken = state.GuestToken;

                    if (activeOrderId.HasValue)
                    {
                        var existingOrder = await Db.Orders
                            .AsNoTracking()
                            .FirstOrDefaultAsync(x => x.Id == activeOrderId.Value);

                        var tokenIsValid =
                            existingOrder != null &&
                            existingOrder.UserId == null &&
                            GuestOrderToken.Verify(
                                activeGuestToken,
                                existingOrder.GuestAccessTokenHash);

                        if (!tokenIsValid)
                        {
                            cart.Clear();
                            activeOrderId = null;
                            activeGuestToken = null;
                            activeOrderNumber = null;

                            await ClearPersistentCartAsync();

                            errorMessage =
                                "سفارش قبلی به حساب کاربری متصل شده یا اطلاعات دسترسی آن معتبر نیست. سبد مهمان پاک شد.";
                        }
                        else
                        {
                            activeOrderNumber = existingOrder!.OrderNumber;
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                "بازیابی سبد سفارش از مرورگر ناموفق بود: " +
                ex.GetBaseException().Message;
        }
        finally
        {
            isCartLoaded = true;
            StateHasChanged();
        }
    }

    private void GoToProduct(DocumentType doc)
    {
        Navigation.NavigateTo($"/order/product/{doc.Id}");
    }

    private void BackToProducts()
    {
        Navigation.NavigateTo("/order/create");
    }

    private static string GetPricingTypeText(DocumentType doc) =>
        doc.PricingType switch
        {
            PricingType.Fixed => "قیمت ثابت",
            PricingType.PerLine => "محاسبه بر اساس سطر",
            PricingType.PerPage => "محاسبه بر اساس صفحه",
            _ => "ترجمه رسمی"
        };

    private static string GetDocumentIcon(DocumentType doc) =>
        doc.Name.Contains("شناسنامه") ? "bi bi-person-vcard" :
        doc.Name.Contains("ریزنمرات") ? "bi bi-mortarboard" :
        doc.Name.Contains("قرارداد") ? "bi bi-file-earmark-text" :
        doc.PricingType == PricingType.PerPage ? "bi bi-file-earmark-richtext" :
        doc.PricingType == PricingType.PerLine ? "bi bi-text-paragraph" :
        "bi bi-file-earmark-check";

    private static string GetDocumentDescription(DocumentType doc)
    {
        if (!string.IsNullOrWhiteSpace(doc.Description))
            return doc.Description;

        if (doc.Name.Contains("شناسنامه"))
            return "ترجمه رسمی شناسنامه برای ارائه به سفارت‌ها، دانشگاه‌ها و سازمان‌های داخل یا خارج از کشور. امکان انتخاب تأیید دادگستری و وزارت امور خارجه نیز وجود دارد.";

        if (doc.Name.Contains("ریزنمرات"))
            return "ترجمه رسمی ریزنمرات و سوابق تحصیلی برای ارائه به دانشگاه‌ها، مراکز آموزشی و مراجع ارزیابی مدارک. هزینه بر اساس تعداد صفحات محاسبه می‌شود.";

        if (doc.Name.Contains("قرارداد"))
            return "ترجمه رسمی قراردادها و اسناد توافقی برای ارائه به مراجع قانونی، شرکت‌ها و سازمان‌ها. هزینه بر اساس تعداد سطرهای متن محاسبه می‌شود.";

        return doc.PricingType switch
        {
            PricingType.Fixed => "هزینه ترجمه این مدرک به‌صورت ثابت محاسبه می‌شود. در صورت نیاز می‌توانید خدمات تأیید دادگستری و وزارت امور خارجه را نیز انتخاب کنید.",
            PricingType.PerLine => "هزینه ترجمه این مدرک بر اساس تعداد سطرهای متن محاسبه می‌شود. تعداد سطرها و خدمات تأیید موردنیاز را در ادامه مشخص کنید.",
            PricingType.PerPage => "هزینه ترجمه این مدرک بر اساس تعداد صفحات محاسبه می‌شود. تعداد صفحات و خدمات تأیید موردنیاز را در ادامه مشخص کنید.",
            _ => "جزئیات و گزینه‌های موردنیاز برای ثبت سفارش را در این صفحه انتخاب کنید."
        };
    }

    private static string GetDocumentShortDescription(DocumentType doc)
    {
        var description = GetDocumentDescription(doc);
        return description.Length > 105 ? description[..102] + "..." : description;
    }


    private void OnUnitsChanged(ChangeEventArgs e)
    {
        units = int.TryParse(e.Value?.ToString(), out int val) && val > 0
            ? val : 1;

        CalculatePrice();
    }

    private void OnQuantityChanged(ChangeEventArgs e)
    {
        quantity = int.TryParse(e.Value?.ToString(), out int val) && val > 0
            ? val : 1;

        CalculatePrice();
    }

    private void OnJudiciaryChanged(ChangeEventArgs e)
    {
        needJudiciary = e.Value is bool value && value;
        CalculatePrice();
    }

    private void OnForeignChanged(ChangeEventArgs e)
    {
        needForeignAffairs = e.Value is bool value && value;
        CalculatePrice();
    }

    private void CalculatePrice()
    {
        if (selectedDoc == null)
        {
            currentPrice = 0;
            return;
        }

        currentPrice = Pricing.Calculate(
            selectedDoc,
            units,
            quantity,
            needJudiciary,
            needForeignAffairs);
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;

        try
        {
            var files = e.GetMultipleFiles(MaxFilesPerDocument);

            if (selectedFiles.Count + files.Count > MaxFilesPerDocument)
            {
                errorMessage =
                    "برای هر مدرک حداکثر ۱۰ فایل می‌توانید انتخاب کنید.";
                return;
            }

            long currentTotalSize = selectedFiles.Sum(x => x.Size);

            foreach (var file in files)
            {
                var extension = Path.GetExtension(file.Name);

                if (!AllowedExtensions.Contains(extension))
                {
                    errorMessage =
                        $"فرمت فایل «{file.Name}» مجاز نیست.";
                    return;
                }

                if (file.Size <= 0 || file.Size > MaxFileSize)
                {
                    errorMessage =
                        $"حجم فایل «{file.Name}» باید بیشتر از صفر و حداکثر ۱۰ مگابایت باشد.";
                    return;
                }

                if (selectedFiles.Any(x =>
                    x.Name == Path.GetFileName(file.Name) &&
                    x.Size == file.Size))
                {
                    continue;
                }

                if (currentTotalSize + file.Size >
                    MaxTotalFileSizePerDocument)
                {
                    errorMessage =
                        "مجموع حجم فایل‌های هر مدرک نباید بیشتر از ۳۰ مگابایت باشد.";
                    return;
                }

                await using var input = file.OpenReadStream(MaxFileSize);
                await using var memory = new MemoryStream();

                await input.CopyToAsync(memory);

                var bytes = memory.ToArray();

                if (bytes.Length != file.Size)
                {
                    errorMessage =
                        $"خواندن فایل «{file.Name}» کامل انجام نشد. دوباره انتخابش کن.";
                    return;
                }

                selectedFiles.Add(new UploadedFileData
                {
                    Name = Path.GetFileName(file.Name),
                    Size = file.Size,
                    ContentType = file.ContentType,
                    Extension = extension.ToLowerInvariant(),
                    Content = bytes
                });

                currentTotalSize += file.Size;
            }
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = $"خطا در انتخاب فایل: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"خطا در خواندن فایل: {ex.GetBaseException().Message}";
        }
    }

    private void RemoveSelectedFile(UploadedFileData file)
    {
        selectedFiles.Remove(file);
    }

    private async Task AddToCart()
    {
        errorMessage = null;

        if (selectedDoc == null)
        {
            errorMessage = "لطفاً نوع مدرک را انتخاب کنید.";
            return;
        }

        if (quantity < 1 || units < 1)
        {
            errorMessage =
                "تعداد نسخه و تعداد واحد باید حداقل یک باشد.";
            return;
        }

        if (selectedFiles.Count > MaxFilesPerDocument ||
            selectedFiles.Sum(x => x.Size) > MaxTotalFileSizePerDocument)
        {
            errorMessage = "تعداد یا حجم فایل‌های انتخاب‌شده مجاز نیست.";
            return;
        }

        cart.Add(new CartItem
        {
            DocumentTypeId = selectedDoc.Id,
            DocumentName = selectedDoc.Name,
            Units = selectedDoc.PricingType == PricingType.Fixed ? 1 : units,
            Quantity = quantity,
            NeedJudiciary = needJudiciary,
            NeedForeignAffairs = needForeignAffairs,
            TotalPrice = currentPrice,
            Files = selectedFiles.ToList(),
            IsSubmitted = false
        });

        selectedDoc = null;
        selectedFiles.Clear();

        units = 1;
        quantity = 1;
        needJudiciary = false;
        needForeignAffairs = false;
        currentPrice = 0;

        await SavePersistentCartAsync();
        Navigation.NavigateTo("/order/create");
    }

    private async Task RemoveFromCart(CartItem item)
    {
        if (item.IsSubmitted)
            return;

        cart.Remove(item);
        await SavePersistentCartAsync();
    }

    private async Task SubmitOrder()
    {
        var pendingItems = cart
            .Where(x => !x.IsSubmitted)
            .ToList();

        if (!pendingItems.Any() || isSubmitting)
            return;

        isSubmitting = true;
        errorMessage = null;

        string guestToken = activeGuestToken ?? GuestOrderToken.Generate();

        var savedDocuments = new List<OrderDocument>();

        try
        {
            await using var transaction =
                await Db.Database.BeginTransactionAsync();

            Order order;
            var isNewOrder = !activeOrderId.HasValue;

            if (isNewOrder)
            {
                order = new Order
                {
                    OrderNumber = "TR-" +
                        Guid.NewGuid().ToString("N")[..12].ToUpperInvariant(),

                    UserId = null,
                    GuestAccessTokenHash = GuestOrderToken.Hash(guestToken),
                    Status = "PendingPayment",
                    ProgressStatus = "Pending",
                    CreatedAt = DateTime.Now
                };

                Db.Orders.Add(order);
            }
            else
            {
                order = await Db.Orders
                    .Include(x => x.Items)
                    .FirstOrDefaultAsync(x => x.Id == activeOrderId!.Value)
                    ?? throw new InvalidOperationException(
                        "سفارش مهمان قبلی پیدا نشد.");

                if (order.UserId != null)
                {
                    throw new InvalidOperationException(
                        "این سفارش قبلاً به حساب کاربری متصل شده است. برای ثبت سفارش جدید، سبد جدید ایجاد کنید.");
                }

                if (!GuestOrderToken.Verify(
                    guestToken,
                    order.GuestAccessTokenHash))
                {
                    throw new InvalidOperationException(
                        "توکن دسترسی سفارش معتبر نیست. امکان افزودن اطلاعات وجود ندارد.");
                }

                if (order.Status != "PendingPayment")
                {
                    throw new InvalidOperationException(
                        "به این سفارش به دلیل وضعیت فعلی آن نمی‌توان اطلاعات جدید اضافه کرد.");
                }
            }

            var newOrderItems = new List<(CartItem Cart, OrderItem Item)>();

            foreach (var cartItem in pendingItems)
            {
                var documentType = await Db.DocumentTypes
                    .FirstOrDefaultAsync(x =>
                        x.Id == cartItem.DocumentTypeId &&
                        x.IsActive);

                if (documentType == null)
                {
                    throw new InvalidOperationException(
                        $"مدرک «{cartItem.DocumentName}» دیگر فعال نیست.");
                }

                if (cartItem.Quantity < 1 || cartItem.Units < 1)
                {
                    throw new InvalidOperationException(
                        "تعداد نسخه یا تعداد واحد معتبر نیست.");
                }

                if (cartItem.Files.Count > MaxFilesPerDocument ||
                    cartItem.Files.Sum(x => x.Size) >
                    MaxTotalFileSizePerDocument)
                {
                    throw new InvalidOperationException(
                        "تعداد یا حجم فایل‌های یکی از مدارک مجاز نیست.");
                }

                foreach (var file in cartItem.Files)
                {
                    var extension = Path.GetExtension(file.Name);

                    if (!AllowedExtensions.Contains(extension) ||
                        file.Content.Length == 0 ||
                        file.Content.Length > MaxFileSize ||
                        file.Content.LongLength != file.Size)
                    {
                        throw new InvalidOperationException(
                            $"فایل «{file.Name}» معتبر نیست.");
                    }
                }

                var itemPrice = Pricing.Calculate(
                    documentType,
                    cartItem.Units,
                    cartItem.Quantity,
                    cartItem.NeedJudiciary,
                    cartItem.NeedForeignAffairs);

                var orderItem = new OrderItem
                {
                    DocumentTypeId = documentType.Id,
                    Units = documentType.PricingType == PricingType.Fixed
                        ? 1
                        : cartItem.Units,
                    Quantity = cartItem.Quantity,
                    NeedJudiciary = cartItem.NeedJudiciary,
                    NeedForeignAffairs = cartItem.NeedForeignAffairs,
                    TotalPrice = itemPrice,
                    Status = "Pending"
                };

                order.Items.Add(orderItem);

                newOrderItems.Add((cartItem, orderItem));

                order.TotalPrice += itemPrice;
            }

            await Db.SaveChangesAsync();

            foreach (var entry in newOrderItems)
            {
                foreach (var file in entry.Cart.Files)
                {
                    var savedDocument = await DocumentStorage.SaveAsync(
                        file.Name,
                        file.Content,
                        order.Id,
                        entry.Item.Id);

                    savedDocuments.Add(savedDocument);
                    Db.OrderDocuments.Add(savedDocument);
                }
            }

            await Db.SaveChangesAsync();

            await transaction.CommitAsync();

            activeOrderId = order.Id;
            activeOrderNumber = order.OrderNumber;
            activeGuestToken = guestToken;

            foreach (var item in pendingItems)
            {
                item.IsSubmitted = true;

                // پس از ذخیره موفق در سرور، دیگر نیازی به نگهداری بایت فایل نیست.
                foreach (var file in item.Files)
                {
                    file.Content = Array.Empty<byte>();
                }
            }

            await SavePersistentCartAsync();

            Navigation.NavigateTo(
                $"/order/success/{order.Id}?token={Uri.EscapeDataString(guestToken)}");
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();

            foreach (var file in savedDocuments)
            {
                try
                {
                    await DocumentStorage.DeleteAsync(file.StoredFileName);
                }
                catch
                {
                    // خطای پاک‌سازی نباید خطای اصلی را پنهان کند.
                }
            }

            errorMessage =
                $"ثبت سفارش با خطا مواجه شد: {ex.GetBaseException().Message}";

            Console.Error.WriteLine(ex);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task SavePersistentCartAsync()
    {
        if (cartStorage == null)
            return;

        var state = new GuestCartState
        {
            OrderId = activeOrderId,
            GuestToken = activeGuestToken,
            Items = cart
        };

        var json = JsonSerializer.Serialize(state, JsonOptions);

        await cartStorage.InvokeVoidAsync("saveCart", json);
    }

    private async Task ClearPersistentCartAsync()
    {
        if (cartStorage == null)
            return;

        await cartStorage.InvokeVoidAsync("clearCart");
    }

    private static string FormatFileSize(long size)
    {
        return size < 1024 * 1024
            ? $"{size / 1024.0:N0} KB"
            : $"{size / (1024.0 * 1024):N2} MB";
    }

    public class GuestCartState
    {
        public int? OrderId { get; set; }
        public string? GuestToken { get; set; }
        public List<CartItem> Items { get; set; } = new();
    }

    public class UploadedFileData
    {
        public string Name { get; set; } = "";
        public long Size { get; set; }
        public string ContentType { get; set; } = "";
        public string Extension { get; set; } = "";
        public byte[] Content { get; set; } = Array.Empty<byte>();
    }

    public class CartItem
    {
        public int DocumentTypeId { get; set; }
        public string DocumentName { get; set; } = "";
        public int Units { get; set; }
        public int Quantity { get; set; }
        public bool NeedJudiciary { get; set; }
        public bool NeedForeignAffairs { get; set; }
        public decimal TotalPrice { get; set; }
        public List<UploadedFileData> Files { get; set; } = new();
        public bool IsSubmitted { get; set; }
    }
}
