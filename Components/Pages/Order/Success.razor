@page "/order/success/{OrderId:int}"

@using TranslationOffice.Data
@using TranslationOffice.Models
@using TranslationOffice.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject CartService CartService

@rendermode InteractiveServer

@if (isLoading)
{
    <div class="text-center my-5">
        <p>در حال بارگذاری اطلاعات سفارش...</p>
    </div>
}
else if (order == null || !canView)
{
    <div class="alert alert-danger text-center my-5">
        سفارش موردنظر پیدا نشد یا شما اجازه مشاهده آن را ندارید.
    </div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card border-success">

                <div class="card-header bg-success text-white text-center">
                    <h4 class="mb-0">سفارش شما با موفقیت ثبت شد</h4>
                </div>

                <div class="card-body text-center">

                    <div class="mb-4">
                        <div class="display-6 text-success mb-2">✓</div>
                        <p class="fs-5">شماره سفارش شما:</p>
                        <h3 class="text-primary">@order.OrderNumber</h3>
                    </div>

                    <div class="row text-start mb-4">

                        <div class="col-md-6">
                            <p>
                                <strong>تاریخ ثبت:</strong>
                                @order.CreatedAt.ToString("yyyy/MM/dd - HH:mm")
                            </p>

                            <p>
                                <strong>وضعیت:</strong>
                                <span class="badge bg-warning text-dark">
                                    @GetStatusText(order.Status)
                                </span>
                            </p>
                        </div>

                        <div class="col-md-6">
                            <p><strong>مبلغ کل:</strong></p>
                            <h4 class="text-success">
                                @order.TotalPrice.ToString("N0") تومان
                            </h4>
                        </div>

                    </div>

                    <hr />

                    <h5 class="mb-3">جزئیات سفارش</h5>

                    <div class="table-responsive">
                        <table class="table table-bordered table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>مدرک</th>
                                    <th>تعداد نسخه</th>
                                    <th>سطر/صفحه</th>
                                    <th>دادگستری</th>
                                    <th>خارجه</th>
                                    <th>قیمت</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in order.Items)
                                {
                                    <tr>
                                        <td>@item.DocumentType?.Name</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.Units</td>
                                        <td>@(item.NeedJudiciary ? "بله" : "خیر")</td>
                                        <td>@(item.NeedForeignAffairs ? "بله" : "خیر")</td>
                                        <td>@item.TotalPrice.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (showClaimButton)
                    {
                        <div class="alert alert-info mt-4">
                            <p class="mb-2">
                                این سفارش هنوز به حساب کاربری شما متصل نشده است.
                            </p>

                            @if (isAuthenticated)
                            {
                                <a href="@claimUrl" class="btn btn-success">
                                    اتصال سفارش به حساب من
                                </a>
                            }
                            else
                            {
                                <p class="mb-3">
                                    برای نگهداری و پیگیری سفارش، وارد حساب خود شوید
                                    یا ثبت‌نام کنید.
                                </p>

                                <a href="@loginUrl" class="btn btn-primary me-2">
                                    ورود به حساب
                                </a>

                                <a href="@registerUrl" class="btn btn-outline-success">
                                    ثبت‌نام
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success mt-4">
                            این سفارش به حساب کاربری شما متصل است.
                        </div>
                    }

                    <div class="mt-4">
                        <button class="btn btn-primary me-2"
                                @onclick="GoToNewOrder">
                            ثبت سفارش جدید
                        </button>

                        <button class="btn btn-outline-secondary"
                                @onclick="GoToHome">
                            بازگشت به صفحه اصلی
                        </button>
                    </div>

                    <div class="alert alert-info mt-4 mb-0">
                        کارشناسان ما به زودی با شما تماس خواهند گرفت.
                    </div>

                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int OrderId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "claimed")]
    public int? Claimed { get; set; }

    private Order? order;

    private bool isLoading = true;
    private bool canView;
    private bool showClaimButton;
    private bool isAuthenticated;

    private string claimUrl = "";
    private string loginUrl = "";
    private string registerUrl = "";


    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        canView = false;
        showClaimButton = false;

        order = await Db.Orders
            .AsNoTracking()
            .Include(o => o.Items)
                .ThenInclude(i => i.DocumentType)
            .FirstOrDefaultAsync(o => o.Id == OrderId);

        if (order == null)
        {
            isLoading = false;
            return;
        }

        var authState =
            await AuthStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        isAuthenticated = user.Identity?.IsAuthenticated == true;

        var currentUserId =
            user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        var isOwner =
            isAuthenticated &&
            !string.IsNullOrWhiteSpace(currentUserId) &&
            order.UserId == currentUserId;

        var validGuestToken =
            order.UserId == null &&
            GuestOrderToken.Verify(
                Token,
                order.GuestAccessTokenHash);

        canView = isOwner || validGuestToken;

        if (isOwner)
        {
            showClaimButton = false;

            // پس از اتصال موفق سفارش، سبد ذخیره‌شده در دیتابیس پاک می‌شود.
            if (Claimed == 1)
                await CartService.DeleteByOrderIdAsync(OrderId);
        }
        else if (validGuestToken)
        {
            showClaimButton = true;

            claimUrl =
                $"/order/claim/{order.Id}?token={Uri.EscapeDataString(Token!)}";

            loginUrl =
                $"/Account/Login?ReturnUrl={Uri.EscapeDataString(claimUrl)}";

            registerUrl =
                $"/Account/Register?ReturnUrl={Uri.EscapeDataString(claimUrl)}";
        }

        isLoading = false;
    }

    private string GetStatusText(string status) => status switch
    {
        "PendingPayment" => "در انتظار پرداخت",
        "Paid" => "پرداخت شده",
        "Pending" => "در انتظار بررسی",
        "Processing" => "در حال انجام",
        "InProgress" => "در حال انجام",
        "Completed" => "تکمیل شده",
        "Cancelled" => "لغو شده",
        _ => status
    };

    private void GoToNewOrder()
    {
        Navigation.NavigateTo("/order/create");
    }

    private void GoToHome()
    {
        Navigation.NavigateTo("/");
    }
}
