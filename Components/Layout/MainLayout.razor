@inherits LayoutComponentBase
@implements IDisposable

@using System.Security.Claims
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using TranslationOffice.Data
@using TranslationOffice.Models
@using TranslationOffice.Services

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject CartService CartService
@inject PersistentComponentState PersistentState
@inject IHttpContextAccessor HttpContextAccessor

<HeadContent>
    <link href="/css/mainlayout.css?v=4" rel="stylesheet" />
</HeadContent>

<div class="app-wrapper home-layout" dir="rtl">

    <header class="site-header">
        <div class="layout-container">
            <nav class="main-navbar">

                <a href="/" class="brand" data-enhance-nav="false">
                    <span class="brand-logo">
                        <span class="brand-logo-icon">ت</span>
                    </span>
                    <span class="brand-text">
                        <strong>دارالترجمه رسمی</strong>
                        <small>ترجمه دقیق، اعتماد ماندگار</small>
                    </span>
                </a>

                <button class="mobile-menu-toggle"
                        type="button"
                        @onclick="ToggleMenu"
                        aria-controls="mainNav"
                        aria-expanded="@isMenuOpen"
                        aria-label="نمایش یا بستن منو">
                    <span class="@(isMenuOpen ? "toggle-line open" : "toggle-line")"></span>
                    <span class="@(isMenuOpen ? "toggle-line open" : "toggle-line")"></span>
                    <span class="@(isMenuOpen ? "toggle-line open" : "toggle-line")"></span>
                </button>

                <div class="main-nav-content @(isMenuOpen ? "is-open" : "")" id="mainNav">

                    <ul class="navbar-nav main-menu">
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All" @onclick="CloseMenu">
                                <span class="menu-icon">⌂</span>
                                صفحه اصلی
                            </NavLink>
                        </li>

                        <li class="nav-item">
                            <NavLink class="nav-link" href="/order/create" @onclick="CloseMenu">
                                <span class="menu-icon">＋</span>
                                ثبت سفارش
                            </NavLink>
                        </li>

                        @if (isCustomer)
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="/account/orders" @onclick="CloseMenu">
                                    <span class="menu-icon">▤</span>
                                    سفارش‌های من
                                </NavLink>
                            </li>
                            <li class="nav-item">
                                <NavLink class="nav-link" href="/account/profile" @onclick="CloseMenu">
                                    <span class="menu-icon">♙</span>
                                    پروفایل من
                                </NavLink>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="/admin/orders" @onclick="CloseMenu">
                                    <span class="menu-icon">▦</span>
                                    سفارش‌ها
                                </NavLink>
                            </li>
                            <li class="nav-item">
                                <NavLink class="nav-link" href="/admin/documents" @onclick="CloseMenu">
                                    <span class="menu-icon">▧</span>
                                    اسناد
                                </NavLink>
                            </li>
                            <li class="nav-item">
                                <NavLink class="nav-link" href="/admin/translators" @onclick="CloseMenu">
                                    <span class="menu-icon">♙</span>
                                    مترجمان
                                </NavLink>
                            </li>
                        }

                        @if (isTranslator)
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="/translator/orders" @onclick="CloseMenu">
                                    <span class="menu-icon">▤</span>
                                    پنل مترجم
                                </NavLink>
                            </li>
                        }
                    </ul>

                    <div class="nav-actions">
                        <a href="/order/cart"
                           class="header-cart-link @(cartAnimation ? "cart-animate" : "")"
                           aria-label="سبد سفارش، @cartItemCount قلم"
                           title="سبد سفارش">
                            <span class="header-cart-icon"><i class="bi bi-cart3"></i></span>
                            @if (cartItemCount > 0)
                            {
                                <span class="header-cart-count">@cartItemCount</span>
                            }
                            <span class="header-cart-label">سبد سفارش</span>
                        </a>
                        <AuthorizeView>
                            <Authorized Context="auth">
                                <div class="user-profile">
                                    <div class="user-avatar">
                                        @(GetInitial(auth.User.Identity?.Name))
                                    </div>
                                    <div class="user-info">
                                        <span>خوش آمدید</span>
                                        <strong>@auth.User.Identity?.Name</strong>
                                    </div>
                                </div>
                                <a href="/Account/Logout" data-enhance-nav="false" class="logout-link">
                                    <span>↪</span>
                                    خروج
                                </a>
                            </Authorized>
                            <NotAuthorized>
                                <a href="/Account/Login" data-enhance-nav="false" class="login-link">ورود</a>
                                <a href="/Account/Register" data-enhance-nav="false" class="register-link">ثبت‌نام</a>
                            </NotAuthorized>
                        </AuthorizeView>

                        <a href="/order/create" class="header-order-button" @onclick="CloseMenu">
                            ثبت سفارش جدید
                            <span>←</span>
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>

    <footer class="site-footer">
        <div class="layout-container">
            <div class="footer-main">
                <div class="footer-brand-section">
                    <div class="footer-brand">
                        <span class="footer-brand-icon">ت</span>
                        <strong>دارالترجمه رسمی</strong>
                    </div>
                    <p>
                        خدمات ترجمه رسمی، دقیق و مطمئن؛
                        همراه شما در مسیر ارتباط با جهان.
                    </p>
                </div>
                <div class="footer-links">
                    <strong>دسترسی سریع</strong>
                    <a href="/">صفحه اصلی</a>
                    <a href="/order/create">ثبت سفارش</a>
                    <a href="/account/orders">سفارش‌های من</a>
                    <a href="/account/profile">پروفایل من</a>
                </div>
                <div class="footer-contact">
                    <strong>خدمات ما</strong>
                    <span>ترجمه رسمی اسناد</span>
                    <span>ترجمه مدارک تحصیلی</span>
                    <span>ترجمه مدارک هویتی</span>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© تمامی حقوق متعلق به دارالترجمه رسمی است.</span>
                <span>کیفیت، دقت و اعتماد در ترجمه</span>
            </div>
        </div>
    </footer>
</div>

@code {
    private bool isAdmin;
    private bool isTranslator;
    private bool isCustomer;
    private bool isMenuOpen;
    private int cartItemCount;
    private string cartStorageKey = "guest";
    private bool cartAnimation;
    private PersistingComponentStateSubscription guestCartKeySubscription;

    protected override async Task OnInitializedAsync()
    {
        CartService.CartChanged += HandleCartChanged;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);

        if (user.Identity?.IsAuthenticated == true &&
            !string.IsNullOrWhiteSpace(userId))
        {
            cartStorageKey = $"user:{userId}";
        }
        else
        {
            if (!PersistentState.TryTakeFromJson<string>("NikaGuestCartKey", out var guestKey) ||
                string.IsNullOrWhiteSpace(guestKey))
            {
                guestKey =
                    HttpContextAccessor.HttpContext?.Items["NikaGuestCartKey"] as string
                    ?? HttpContextAccessor.HttpContext?.Request.Cookies["nika-cart-id"]
                    ?? Guid.NewGuid().ToString("N");

                guestCartKeySubscription =
                    PersistentState.RegisterOnPersisting(PersistGuestCartKeyAsync);
            }

            CartService.GuestCartKey = guestKey;
            cartStorageKey = $"guest:{guestKey}";
        }

        cartItemCount = await CartService.GetCountAsync(cartStorageKey);

        if (user.Identity?.IsAuthenticated != true ||
            string.IsNullOrWhiteSpace(userId))
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var role = await db.Users
            .AsNoTracking()
            .Where(x => x.Id == userId)
            .Select(x => x.Role)
            .FirstOrDefaultAsync();

        isAdmin = role == "Admin";
        isTranslator = role == "Translator";
        isCustomer = role == "Customer";
    }

    private Task PersistGuestCartKeyAsync()
    {
        PersistentState.PersistAsJson("NikaGuestCartKey", CartService.GuestCartKey);
        return Task.CompletedTask;
    }

    private void HandleCartChanged(string storageKey, int itemCount)
    {
        if (!string.Equals(storageKey, cartStorageKey, StringComparison.Ordinal))
            return;

        _ = InvokeAsync(async () =>
        {
            cartItemCount = Math.Max(0, itemCount);
            cartAnimation = cartItemCount > 0;
            StateHasChanged();

            if (cartAnimation)
            {
                await Task.Delay(650);
                cartAnimation = false;
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        CartService.CartChanged -= HandleCartChanged;
        guestCartKeySubscription.Dispose();
    }

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;

    private static string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "ک";
        return name.Trim().Substring(0, 1);
    }
}
